<!-- Botão Conectar MetaMask -->
<button id="connectMetaMask" style="padding: 12px 24px; background: #f6851b; color: white; border: none; border-radius: 8px; font-size: 16px; cursor: pointer; font-weight: bold;">
    🦊 Conectar MetaMask
</button>

<p id="walletAddress" style="margin-top: 12px; font-family: sans-serif;"></p>

<script>
const connectBtn = document.getElementById('connectMetaMask');
const addressDisplay = document.getElementById('walletAddress');

connectBtn.addEventListener('click', async () => {
    // Verifica se a MetaMask está instalada
    if (typeof window.ethereum !== 'undefined') {
        try {
            // Solicita conexão com a carteira
            const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
            const account = accounts[0];
            
            // Mostra o endereço conectado
            addressDisplay.textContent = `✅ Conectado: ${account.slice(0, 6)}...${account.slice(-4)}`;
            connectBtn.textContent = '✅ Carteira Conectada';
            connectBtn.style.background = '#22c55e';
            
        } catch (erro) {
            addressDisplay.textContent = '❌ Conexão recusada ou ocorreu um erro';
        }
    } else {
        // Se não tiver MetaMask instalada
        alert('🦊 Instale a MetaMask primeiro!\nBaixe em: metamask.io/download');
        window.open('https://metamask.io/download', '_blank');
    }
});
</script>
